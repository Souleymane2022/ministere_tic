# ===== Base de données =====
DATABASE_URL=postgresql://user:password@localhost:5432/sht_portail

# ===== JWT =====
JWT_SECRET=your_jwt_secret_here_change_me_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Serveur =====
PORT=5000
NODE_ENV=development

# ===== Client =====
CLIENT_URL=http://localhost:3000

# ===== Uploads =====
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ===== 2FA =====
TOTP_ISSUER=SHT-Portail

# ===== Bcrypt =====
BCRYPT_ROUNDS=10
